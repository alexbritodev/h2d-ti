# Copie para /opt/h2d/.env na VPS. Nunca vai para o Git e nunca se reaproveita o .env local.
# Gere cada segredo com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Guarde uma cópia no gerenciador de senhas: sem ela, o banco não é recuperável.

# Endereço público do app. O DNS (registro A) precisa apontar para a VPS antes do primeiro deploy.
H2D_DOMAIN=h2d.exemplo.com.br

# Dono das imagens no GHCR, em minúsculas.
GHCR_OWNER=danubiolagoa

POSTGRES_PASSWORD=troque-me
H2D_DB_PASSWORD=troque-me
N8N_DB_PASSWORD=troque-me
JWT_SECRET=troque-me-com-pelo-menos-32-caracteres

# Só para uma demonstração com dados fictícios. Deixe false em dados reais e use h2d.create_admin.
ALLOW_DEMO_SEED=false
SEED_PASSWORD=
