# Caddy interno do container "h2d-web": serve a SPA e encaminha /api. Fala HTTP puro na 8080.
# O HTTPS e o certificado ficam com o Caddy da VPS, que recebe as portas 80 e 443.
# O banco e o n8n nunca passam por aqui (divergências D2 e D4).
{
	auto_https off
	admin off
	servers {
		# Confia nos cabeçalhos X-Forwarded-* que vêm do Caddy da VPS (rede Docker privada).
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Usado pelo healthcheck do container.
	handle /healthz {
		respond "ok" 200
	}

	# Webhooks do n8n chegam à API pela rede interna do Docker (h2d-api:8000), nunca por fora.
	handle /api/hooks/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy h2d-api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
