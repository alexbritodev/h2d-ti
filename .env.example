# Copie para .env e troque todos os valores. O .env nunca vai para o Git.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Superusuário do PostgreSQL (usado só na criação dos bancos e extensões)
POSTGRES_PASSWORD=troque-me

# Senhas dos usuários de aplicação: bancos h2d e n8n são separados
H2D_DB_PASSWORD=troque-me
N8N_DB_PASSWORD=troque-me

# Porta local do banco. 5433 evita conflito com um PostgreSQL já instalado na máquina.
DB_PORT=5433

# Porta local da API. 8010 evita conflito com outros projetos na 8000.
API_PORT=8010

# Autenticação. Mínimo de 32 caracteres.
JWT_SECRET=troque-me-com-pelo-menos-32-caracteres

# Senha de todos os usuários criados pelo seed (somente desenvolvimento)
SEED_PASSWORD=troque-me

# Chave do OpenRouter (F2 e F3). Opcional por enquanto. Defina o limite mensal de gasto na conta do provedor.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------------------------
# PRODUÇÃO (stack do Portainer, docker-compose.yml). Estes valores NÃO ficam em arquivo:
# cadastre-os em "Environment variables" do stack. Aqui só estão os nomes.
# Gere cada segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Obrigatórias (o compose recusa subir sem elas):
#   POSTGRES_PASSWORD, H2D_DB_PASSWORD, N8N_DB_PASSWORD   segredos, um valor diferente em cada
#   JWT_SECRET                                            segredo, mínimo de 32 caracteres
#   N8N_ENCRYPTION_KEY                                    segredo; guarde fora da VPS, sem ela
#                                                         as credenciais do n8n não abrem
#   N8N_DOMAIN                                            host do n8n, sem https:// (ex.: n8n.exemplo.com)
# Opcionais:
#   OPENROUTER_API_KEY=     chave do OpenRouter (F2 e F3); cadastre só no Portainer
#   ALLOW_DEMO_SEED=false   só "true" para demonstração com dados fictícios
#   SEED_PASSWORD=          só com ALLOW_DEMO_SEED=true
# O domínio do app (H2D_DOMAIN) não entra no compose: ele só aparece no Caddy da VPS.
# Não há variáveis de build do frontend (nenhum VITE_* em uso).
