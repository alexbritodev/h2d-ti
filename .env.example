# Faz o `docker compose` local usar o ambiente de desenvolvimento. O de produção é outro arquivo
# (docker-compose.yml, usado pelo Portainer); sem esta linha o Compose escolheria o de produção.
COMPOSE_FILE=compose.dev.yaml

# Copie para .env e troque todos os valores. O .env nunca vai para o Git.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Superusuário do PostgreSQL (usado só na criação dos bancos e extensões)
POSTGRES_PASSWORD=troque-me

# Senhas dos usuários de aplicação: bancos h2d e n8n são separados
H2D_DB_PASSWORD=troque-me
N8N_DB_PASSWORD=troque-me

# Porta local do banco. 5433 evita conflito com um PostgreSQL já instalado na máquina.
DB_PORT=5433

# Porta local da API. 8010 evita conflito com outros projetos na 8000.
API_PORT=8010

# Autenticação. Mínimo de 32 caracteres.
JWT_SECRET=troque-me-com-pelo-menos-32-caracteres

# Senha de todos os usuários criados pelo seed (somente desenvolvimento)
SEED_PASSWORD=troque-me

# Segredo do HMAC entre a API e o n8n (opcional no desenvolvimento; há um padrão local).
# Para testar o n8n local: docker compose --profile n8n up -d. O e-mail vai para o Mailpit.
# N8N_HMAC_SECRET=

# Escritório virtual (experimento, veja docs/escritorio-virtual.md). Desligado por padrão: com
# a flag desligada não há rota, item de menu nem evento gravado.
# ESCRITORIO_VIRTUAL_ENABLED=true
# ESCRITORIO_VIRTUAL_DEMO=true

# Chave da API do DeepSeek (https://api.deepseek.com/v1). Quando definida, tem prioridade.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Servidor LLM local (Ollama na VPS com Gemma 4). Quando LLM_BASE_URL é definido, tem prioridade sobre Gemini/OpenRouter.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=gemma4
# LLM_TIMEOUT_SECONDS=120

# Chave da API direta do Google AI Studio (Gemini). Quando definida, tem prioridade sobre o OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Chave do OpenRouter (F2 e F3, alternativa ao Gemini direto). Opcional. Defina o limite mensal de gasto na conta do provedor.
OPENROUTER_API_KEY=
# Opcionais: modelo de linguagem e teto diário de chamadas (padrões gratuitos).
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# LLM_DAILY_REQUEST_LIMIT=1000

# Agentes do Chat (Guardião de Entrada e Validador de Resposta)
# GUARDIAO_ENABLED=true
# GUARDIAO_MODEL=openrouter/free
# GUARDIAO_FAST_ONLY=false
# VALIDADOR_ENABLED=true
# VALIDADOR_MODEL=openrouter/free
# VALIDADOR_CONFIDENCE_THRESHOLD=0.7

# ---------------------------------------------------------------------------------------------
# PRODUÇÃO (stack do Portainer, docker-compose.yml). Estes valores NÃO ficam em arquivo:
# cadastre-os em "Environment variables" do stack. Aqui só estão os nomes.
# Gere cada segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Obrigatórias (o compose recusa subir sem elas):
#   POSTGRES_PASSWORD, H2D_DB_PASSWORD, N8N_DB_PASSWORD   segredos, um valor diferente em cada
#   JWT_SECRET                                            segredo, mínimo de 32 caracteres
#   N8N_ENCRYPTION_KEY                                    segredo; guarde fora da VPS, sem ela
#                                                         as credenciais do n8n não abrem
#   N8N_DOMAIN                                            host do n8n, sem https:// (ex.: n8n.exemplo.com)
# Opcionais:
#   GEMINI_API_KEY=         chave da API direta do Google AI Studio (Gemini); cadastre só no Portainer
#   GEMINI_MODEL=           modelo do Gemini (padrão: gemini-3.1-flash-lite)
#   OPENROUTER_API_KEY=     chave alternativa do OpenRouter (F2 e F3); cadastre só no Portainer
#   N8N_HMAC_SECRET         segredo do HMAC API <-> n8n (gere como os outros). Sem ele, os avisos
#                           de chamado ficam na fila e nada é enviado
#   TI_LEADER_EMAIL         quem recebe a triagem manual e os P1 (líder da TI)
#   MAIL_FROM               remetente dos avisos (ex.: h2d@empresa.com)
#   H2D_BASE_URL            endereço do sistema, para o link no e-mail (https://h2d-ti.tech).
#                           Obrigatória para o convite de usuário: sem ela o e-mail não sai
#   INVITE_TTL_HOURS        validade do link de convite, em horas (padrão 48, mínimo 24)
#   ALLOW_DEMO_SEED=false   só "true" para demonstração com dados fictícios
#   SEED_PASSWORD=          só com ALLOW_DEMO_SEED=true
# O domínio do app (H2D_DOMAIN) não entra no compose: ele só aparece no Caddy da VPS.
# Não há variáveis de build do frontend (nenhum VITE_* em uso).
